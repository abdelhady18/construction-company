# Database (Neon PostgreSQL for production, SQLite for local)
# Get a free Neon DB: https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Auth secret (generate one: openssl rand -hex 32)
AUTH_SECRET="your-random-secret-here"

# Vercel Blob (for image uploads in production)
# Create a token: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Resend (for contact form emails)
# Get an API key: https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxx"
ADMIN_EMAIL="admin@buildco.com"
